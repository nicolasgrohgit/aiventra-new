PORT=4000
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/spotlyte
JWT_SECRET=change-me-to-a-long-random-string
# LiveKit Cloud project -> Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Any long random string; paste the same value in RevenueCat -> Integrations -> Webhooks -> Authorization header
REVENUECAT_WEBHOOK_AUTH=
# Header value for /api/admin/* (x-admin-key)
ADMIN_KEY=
