{
  "expo": {
    "name": "Spotlyte",
    "slug": "spotlyte",
    "scheme": "spotlyte",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0B14",
    "ios": {
      "bundleIdentifier": "com.spotlyte.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Spotlyte uses your camera when you go live.",
        "NSMicrophoneUsageDescription": "Spotlyte uses your microphone when you go live.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.spotlyte.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E0B14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["@livekit/react-native-expo-plugin", { "android": { "audioType": "media" } }],
      "@config-plugins/react-native-webrtc"
    ],
    "extra": {
      "apiUrl": "",
      "revenuecatIosKey": "",
      "revenuecatAndroidKey": ""
    }
  }
}
