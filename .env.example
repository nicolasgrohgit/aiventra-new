# Copy this file to .env and fill in the values you need. .env is gitignored — never commit it.

# --- Backend (server.ts) ---

# Port the Express API server listens on. Optional — defaults to 3000.
PORT=3000

# MongoDB connection string. Required — the server connects to this on boot.
MONGODB_URI=mongodb://localhost:27017/odysai

# Secret used to sign/verify session JWTs. Required — the server refuses to start without
# it (see server.ts). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Sentry DSN for the backend. Optional — error reporting is a complete no-op (no init, no
# network calls) until this is set. Create a free project at https://sentry.io to get one.
SENTRY_DSN=

# Log verbosity for the structured (pino) server logger. Optional — defaults to "info".
# One of: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info

# Shared secret gating the /admin/api/places routes (curated-places admin tool, see
# public/admin.html) — checked against an X-Admin-Token request header. Required for the
# admin API to work at all: with this unset, requireAdminToken (server.ts) fails closed and
# every /admin/api/places route returns 503, rather than silently allowing unauthenticated
# access like before. admin.html prompts for this value client-side and sends it back as a
# header on every admin API call — there's no separate login for the static page itself.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Master key for per-user field encryption at rest (see lib/field-encryption.ts and
# docs/data-encryption-plan.md) — currently used to wrap each user's own random data key,
# which in turn encrypts Event.title / .location / .place_name. Optional and a complete no-op
# until set, same pattern as SENTRY_DSN above: fields simply read/write as plain strings, the
# behavior before this existed. This is the explicit "local-only stopgap" the plan doc calls
# for — a real KMS (GCP Cloud KMS / Secret Manager) is the intended eventual home for this key,
# tracked as part of the still-pending GCP migration (docs/gcp-migration.md), not a plain env
# var forever. Must be exactly 64 hex characters (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key is NOT supported today — every existing wrapped per-user data key
# (User.encryptedDataKey) becomes unreadable if it changes, taking that user's already-
# encrypted Event fields down with it. Back up MongoDB before ever changing this in an
# environment with real data in it.
ENCRYPTION_MASTER_KEY=

# Google Places API (New) key, used to fetch real restaurant/activity data for a city instead
# of synthetic filler (see lib/google-places-client.ts, lib/places-population.ts). Optional —
# a complete no-op until set, same as SENTRY_DSN above: places population silently falls back
# to the existing synthetic generator. To get one: create a project in the Google Cloud
# Console, enable "Places API (New)" and billing (usage should stay within the $200/mo Maps
# Platform free credit at beta scale), then create an API key under APIs & Services >
# Credentials. Consider restricting the key to Places API (New) only.
GOOGLE_PLACES_API_KEY=

# Mail relay used by lib/mailer.ts to email admin@odys.ai when a user submits the "Have a
# suggestion for Odys.ai?" form (Profile). Optional and a complete no-op until set, same
# pattern as SENTRY_DSN above: the suggestion is still durably saved to Mongo either way
# (models/Suggestion.ts), just with `emailed: false`. No real relay is wired up behind this
# yet — see the "Need a real email server on GCP" item in CHANGELOG.md / docs/gcp-migration.md.
SMTP_URL=

# --- Mobile app (Expo) ---
# EXPO_PUBLIC_* vars are inlined into the client JS bundle at build time.

# Public URL the mobile app should call for the backend. Required for any build
# distributed outside `expo start` (e.g. an EAS-built APK for beta testers) — without it,
# a built app falls back to localhost, which on a tester's phone means their own device,
# not your backend. Set this to your localtunnel URL before running `eas build`.
# See docs/beta-deploy.md.
EXPO_PUBLIC_API_URL=

# Sentry DSN for the mobile app. Optional — same as SENTRY_DSN above but for the client;
# also a complete no-op until set.
EXPO_PUBLIC_SENTRY_DSN=

# --- scripts/expose-server.sh ---

# Subdomain used for the localtunnel URL, so it stays stable across restarts instead of
# getting a new random URL every time. Optional — defaults to "odysai-beta". localtunnel
# subdomains are first-come-first-served globally; pick something else if it's taken.
TUNNEL_SUBDOMAIN=odysai-beta
